{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserAction",
  "description": "An action the user performed in the UI.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "TextChanged"
      ],
      "properties": {
        "TextChanged": {
          "type": "object",
          "required": [
            "component_id",
            "value"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "ItemToggled"
      ],
      "properties": {
        "ItemToggled": {
          "type": "object",
          "required": [
            "component_id",
            "item_id"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "item_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "ActionPressed"
      ],
      "properties": {
        "ActionPressed": {
          "type": "object",
          "required": [
            "action_id"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "FieldVisibilityChanged"
      ],
      "properties": {
        "FieldVisibilityChanged": {
          "type": "object",
          "required": [
            "field_id",
            "visible"
          ],
          "properties": {
            "field_id": {
              "type": "string"
            },
            "group_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "visible": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "GroupViewSelected"
      ],
      "properties": {
        "GroupViewSelected": {
          "type": "object",
          "properties": {
            "group_name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "SearchChanged"
      ],
      "properties": {
        "SearchChanged": {
          "type": "object",
          "required": [
            "component_id",
            "query"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "ListItemSelected"
      ],
      "properties": {
        "ListItemSelected": {
          "type": "object",
          "required": [
            "component_id",
            "item_id"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "item_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "SettingsToggled"
      ],
      "properties": {
        "SettingsToggled": {
          "type": "object",
          "required": [
            "component_id",
            "item_id"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "item_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "User pressed Undo on a toast with an undo action.",
      "type": "object",
      "required": [
        "UndoPressed"
      ],
      "properties": {
        "UndoPressed": {
          "type": "object",
          "required": [
            "action_id"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}