{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScreenModel",
  "description": "Describes a full screen to render.",
  "type": "object",
  "required": [
    "actions",
    "components",
    "screen_id",
    "title"
  ],
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ScreenAction"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Component"
      }
    },
    "deprecated_components": {
      "description": "Component types scheduled for removal. Frontends rendering these should display a migration hint in debug builds. Empty unless a deprecation cycle is in progress (2 major versions before removal).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/definitions/Progress"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "description": "Schema version — shells ignore components from higher versions.",
      "default": 3,
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "screen_id": {
      "type": "string"
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "tokens": {
      "description": "Resolved design tokens for layout consistency. Frontends read spacing, radius, typography from here — never hardcode values.",
      "default": {
        "border_radius": {
          "lg": 16,
          "md": 8,
          "md_lg": 12,
          "sm": 4
        },
        "motion": {
          "emphasis_duration_ms": 300,
          "enter_duration_ms": 200,
          "exit_duration_ms": 150
        },
        "spacing": {
          "lg": 24,
          "md": 16,
          "sm": 8,
          "sm_md": 12,
          "xl": 32,
          "xs": 4
        },
        "spacing_direction": {
          "content_end": 16,
          "content_start": 16,
          "list_item_end": 8,
          "list_item_inline_end": 12,
          "list_item_inline_start": 12,
          "list_item_start": 8
        },
        "touch_target": {
          "minimum": 44
        },
        "typography": {
          "body_size": 16,
          "caption_size": 14,
          "subtitle_size": 18,
          "title_size": 24
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/DesignTokens"
        }
      ]
    }
  },
  "definitions": {
    "A11y": {
      "description": "Accessibility metadata for a UI component.\n\nPopulated by core engines so frontends can apply consistent a11y attributes without inventing their own labels.",
      "type": "object",
      "properties": {
        "hint": {
          "description": "Usage hint (maps to accessibilityHint/stateDescription).",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "Screen-reader label (maps to contentDescription/accessibilityLabel).",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Semantic role for screen readers.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/AccessibilityRole"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AccessibilityRole": {
      "description": "Semantic role hint for screen readers.",
      "type": "string",
      "enum": [
        "Button",
        "Link",
        "Heading",
        "Image",
        "Toggle",
        "TextField",
        "Alert"
      ]
    },
    "ActionListItem": {
      "description": "An item in an action list.",
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "a11y": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/A11y"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "info_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "ActionStyle": {
      "description": "Visual style for a screen action.",
      "type": "string",
      "enum": [
        "Primary",
        "Secondary",
        "Destructive"
      ]
    },
    "BorderRadiusTokens": {
      "description": "Border radius tokens for rounded corners.",
      "type": "object",
      "required": [
        "lg",
        "md",
        "md_lg",
        "sm"
      ],
      "properties": {
        "lg": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "md": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "md_lg": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "sm": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      }
    },
    "Component": {
      "description": "A UI component that core tells frontends to render.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Divider"
          ]
        },
        {
          "type": "object",
          "required": [
            "Text"
          ],
          "properties": {
            "Text": {
              "type": "object",
              "required": [
                "content",
                "id",
                "style"
              ],
              "properties": {
                "content": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "style": {
                  "$ref": "#/definitions/TextStyle"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "TextInput"
          ],
          "properties": {
            "TextInput": {
              "type": "object",
              "required": [
                "id",
                "input_type",
                "label",
                "value"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "id": {
                  "type": "string"
                },
                "info_key": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "input_type": {
                  "$ref": "#/definitions/InputType"
                },
                "label": {
                  "type": "string"
                },
                "max_length": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint",
                  "minimum": 0.0
                },
                "placeholder": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "validation_error": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ToggleList"
          ],
          "properties": {
            "ToggleList": {
              "type": "object",
              "required": [
                "id",
                "items",
                "label"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "id": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ToggleItem"
                  }
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "FieldList"
          ],
          "properties": {
            "FieldList": {
              "type": "object",
              "required": [
                "available_groups",
                "fields",
                "id",
                "visibility_mode"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "available_groups": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/FieldDisplay"
                  }
                },
                "id": {
                  "type": "string"
                },
                "visibility_mode": {
                  "$ref": "#/definitions/VisibilityMode"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "CardPreview"
          ],
          "properties": {
            "CardPreview": {
              "type": "object",
              "required": [
                "fields",
                "group_views",
                "name"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "avatar_data": {
                  "description": "Avatar image bytes (WebP). Frontends show this in the circular header area. Falls back to initials from `name` when None.",
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "minimum": 0.0
                  }
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/FieldDisplay"
                  }
                },
                "group_views": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/GroupCardView"
                  }
                },
                "name": {
                  "type": "string"
                },
                "selected_group": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "InfoPanel"
          ],
          "properties": {
            "InfoPanel": {
              "type": "object",
              "required": [
                "id",
                "items",
                "title"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "icon": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/InfoItem"
                  }
                },
                "title": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ContactList"
          ],
          "properties": {
            "ContactList": {
              "type": "object",
              "required": [
                "contacts",
                "id",
                "searchable"
              ],
              "properties": {
                "contacts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ContactItem"
                  }
                },
                "id": {
                  "type": "string"
                },
                "searchable": {
                  "type": "boolean"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "SettingsGroup"
          ],
          "properties": {
            "SettingsGroup": {
              "type": "object",
              "required": [
                "id",
                "items",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/SettingsItem"
                  }
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ActionList"
          ],
          "properties": {
            "ActionList": {
              "type": "object",
              "required": [
                "id",
                "items"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ActionListItem"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "StatusIndicator"
          ],
          "properties": {
            "StatusIndicator": {
              "type": "object",
              "required": [
                "id",
                "status",
                "title"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "detail": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "icon": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "status": {
                  "$ref": "#/definitions/Status"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "PinInput"
          ],
          "properties": {
            "PinInput": {
              "type": "object",
              "required": [
                "filled",
                "id",
                "label",
                "length",
                "masked"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "filled": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0.0
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "length": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0.0
                },
                "masked": {
                  "type": "boolean"
                },
                "validation_error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "QrCode"
          ],
          "properties": {
            "QrCode": {
              "type": "object",
              "required": [
                "data",
                "id",
                "mode"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "data": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mode": {
                  "$ref": "#/definitions/QrMode"
                },
                "scan_quality": {
                  "description": "Real-time scan quality for the viewfinder frame indicator. Only meaningful when `mode` is `Scan`; `None` when `Display`.",
                  "anyOf": [
                    {
                      "$ref": "#/definitions/ScanQuality"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "An inline confirmation for irrevocable actions (expands in place).",
          "type": "object",
          "required": [
            "InlineConfirm"
          ],
          "properties": {
            "InlineConfirm": {
              "type": "object",
              "required": [
                "cancel_text",
                "confirm_text",
                "destructive",
                "id",
                "warning"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cancel_text": {
                  "type": "string"
                },
                "confirm_text": {
                  "type": "string"
                },
                "destructive": {
                  "description": "If true, render confirm button in destructive/red style.",
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "warning": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "A text field that toggles between display and edit mode.",
          "type": "object",
          "required": [
            "EditableText"
          ],
          "properties": {
            "EditableText": {
              "type": "object",
              "required": [
                "editing",
                "id",
                "label",
                "value"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "editing": {
                  "description": "When true, render as editable input. When false, render as static text with edit button.",
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "info_key": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "validation_error": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Informational banner with an optional action button (e.g. preview mode indicator).",
          "type": "object",
          "required": [
            "Banner"
          ],
          "properties": {
            "Banner": {
              "type": "object",
              "required": [
                "action_id",
                "action_label",
                "text"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "action_id": {
                  "type": "string"
                },
                "action_label": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "An inline dropdown for selection UIs (e.g. theme, language). Reuses `UserAction::ListItemSelected` — no new action variant needed.",
          "type": "object",
          "required": [
            "Dropdown"
          ],
          "properties": {
            "Dropdown": {
              "type": "object",
              "required": [
                "id",
                "label",
                "options"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/DropdownOption"
                  }
                },
                "selected": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Circular avatar preview with optional brightness adjustment.\n\nUsed in the Avatar Editor screen and as a display component. When `editable` is true, tapping emits `UserAction::ActionPressed { action_id: \"edit_avatar\" }`.",
          "type": "object",
          "required": [
            "AvatarPreview"
          ],
          "properties": {
            "AvatarPreview": {
              "type": "object",
              "required": [
                "id",
                "initials"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "bg_color": {
                  "description": "Background color for initials fallback `[r, g, b]`.",
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "minimum": 0.0
                  },
                  "maxItems": 3,
                  "minItems": 3
                },
                "brightness": {
                  "description": "Brightness adjustment (-0.3 to 0.3). 0.0 = no change.",
                  "default": 0.0,
                  "type": "number",
                  "format": "float"
                },
                "editable": {
                  "description": "Whether tapping opens the avatar editor (own card only).",
                  "default": false,
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "image_data": {
                  "description": "Raw image bytes (WebP/PNG/JPEG) to display, or None for initials-only fallback.",
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "minimum": 0.0
                  }
                },
                "initials": {
                  "description": "Fallback initials text when no image is available.",
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "A range slider for continuous value input.\n\nEmits `UserAction::SliderChanged { component_id, value }` on value changes.",
          "type": "object",
          "required": [
            "Slider"
          ],
          "properties": {
            "Slider": {
              "type": "object",
              "required": [
                "id",
                "label",
                "max",
                "min",
                "value"
              ],
              "properties": {
                "a11y": {
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/A11y"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "max": {
                  "description": "Maximum allowed value.",
                  "type": "number",
                  "format": "float"
                },
                "max_icon": {
                  "description": "Optional icon name for the max end (e.g., \"sun.max\").",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "min": {
                  "description": "Minimum allowed value.",
                  "type": "number",
                  "format": "float"
                },
                "min_icon": {
                  "description": "Optional icon name for the min end (e.g., \"sun.min\").",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "step": {
                  "description": "Step increment (0.0 = continuous).",
                  "default": 0.0,
                  "type": "number",
                  "format": "float"
                },
                "value": {
                  "description": "Current value.",
                  "type": "number",
                  "format": "float"
