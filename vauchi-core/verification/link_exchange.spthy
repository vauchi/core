/*
 * SPDX-FileCopyrightText: 2026 Mattia Egloff <mattia.egloff@pm.me>
 *
 * SPDX-License-Identifier: AGPL-3.0-or-later
 *
 * The link exchange (ADR-050; `exchange/link_initiator.rs`,
 * `link_responder.rs`): the sender shares a link carrying an ephemeral key
 * and a nonce over a channel of their choosing, and gives the person it is
 * for a short code another way. Whoever opens it runs SPAKE2 over that code
 * in the relay's two-slot handshake gate, both sides derive the escrow keys
 * and swap cards, and each becomes the other's contact (vauchi/private#727).
 *
 * The attacker owns the network and whatever channel carried the link.
 * The relay is the untrusted store the escrow slots live in. Cards and
 * the escrow encryption are out of scope: what matters is who ends up as
 * whose contact.
 *
 * Run: tamarin-prover --prove link_exchange.spthy
 *   The protocol as shipped (#727, SC-74): SPAKE2 over a short code, its key
 *   protecting the opener's identity. VERIFIED, except for the one online
 *   guess per link the design accepts, which rule Online_guess states. The
 *   model assumes SPAKE2's messages offer no offline test; it does not prove
 *   that, and blind/unblind is an abstraction of the primitive.
 * tamarin-prover --prove -DFIRST_OPENER link_exchange.spthy
 *   The protocol before the code. FALSIFIED: the first opener, here the
 *   attacker, becomes the sender's contact.
 * tamarin-prover --prove -DPIN_CONFIRMED link_exchange.spthy
 *   The 2026-10-20 design: a hash of a PIN in the deposit. FALSIFIED: a short
 *   PIN can be tested offline against the hash the attacker sees, which rule
 *   Offline_guess states. A model without that rule called this design safe.
 * Prove it can fail: -DCODE_IN_LINK  (the code travels with the link; the
 *   lemma must be falsified)
 */

theory VauchiLinkExchange
begin

builtins: diffie-hellman, hashing, symmetric-encryption

#ifdef not FIRST_OPENER & not PIN_CONFIRMED
functions: blind/2, unblind/2
equations: unblind(blind(x, c), c) = x
#endif

restriction Equality:
  "All x y #i. Eq(x, y) @ i ==> x = y"

restriction One_guess_per_link:
  "All n #i #j. OneGuess(n) @ i & OneGuess(n) @ j ==> #i = #j"

rule Register:
  [ Fr(~id) ]
  --[ Registered($A, ~id) ]->
  [ !User($A, ~id), Out(~id) ]

/* The sender means the link for one person and tells them so out of
   band; under the PIN design that word includes a PIN, which the attacker
   on the link's channel never sees. */
#ifdef not FIRST_OPENER & not PIN_CONFIRMED
rule Share_link:
  let link = <'link', blind('g' ^ ~e, ~code), ~nonce>
  in
  [ !User($I, id_i), !User($P, id_p), Fr(~e), Fr(~nonce), Fr(~code) ]
  --[ Shared($I, $P) ]->
  [ Sender($I, ~e, ~nonce, ~code), Told($P, ~nonce, ~code), !Code(~nonce, ~code), Out(link) ]

/* Whoever holds a link may run the exchange with one guess at its code, and is
   right about one time in a million. */
rule Online_guess:
  [ !Code(nonce, code) ]
  --[ GuessWon(nonce), OneGuess(nonce) ]->
  [ Out(code) ]
#endif

#ifdef CODE_IN_LINK
/* The control: the code reaches the attacker with the link, and no guess is
   recorded, so the lemma must fail. */
rule Code_travels_with_link:
  [ !Code(nonce, code) ]
  -->
  [ Out(code) ]
#endif
#ifdef PIN_CONFIRMED
rule Share_link:
  let link = <'link', 'g' ^ ~e, ~nonce>
  in
  [ !User($I, id_i), !User($P, id_p), Fr(~e), Fr(~nonce), Fr(~pin) ]
  --[ Shared($I, $P), PinGiven($I, id_p, ~pin) ]->
  [ Sender($I, ~e, ~nonce, ~pin), Told($P, ~nonce, ~pin), !Pin(~pin), Out(link) ]

/* A six-digit PIN is a million hashes: a value that lets an attacker test a
   guess gives the PIN away, without touching the protocol again. */
rule Offline_guess:
  [ !Pin(pin), In(h(<pin, id, fpk, nonce>)) ]
  --[ OfflineGuess(pin) ]->
  [ Out(pin) ]
#endif
#ifdef FIRST_OPENER
rule Share_link:
  let link = <'link', 'g' ^ ~e, ~nonce>
  in
  [ !User($I, id_i), !User($P, id_p), Fr(~e), Fr(~nonce) ]
  --[ Shared($I, $P) ]->
  [ Sender($I, ~e, ~nonce), Told($P, ~nonce), Out(link) ]
#endif

/* Whoever holds the link opens it: deposits an ephemeral key and, under
   the PIN design, proof of the PIN bound to the opener's identity and key.
   The first draft bound only the key, and Tamarin swapped the identity in
   transit (7 steps): the proof must cover what the sender will store. An
   honest opener is the person the sender told; the attacker opens from
   the channel. */
#ifdef not FIRST_OPENER & not PIN_CONFIRMED
rule Open_link:
  let deposit = <'claim', blind('g' ^ ~f, code), senc(id_r, X ^ ~f)>
  in
  [ !User($R, id_r), Told($R, nonce, code), In(<'link', blind(X, code), nonce>), Fr(~f) ]
  --[ Opened($R, nonce), ContactR($R, id_r, X) ]->
  [ Out(deposit) ]
#endif
#ifdef PIN_CONFIRMED
rule Open_link:
  let deposit = <'claim', id_r, 'g' ^ ~f, h(<pin, id_r, 'g' ^ ~f, nonce>)>
  in
  [ !User($R, id_r), Told($R, nonce, pin), In(<'link', epk, nonce>), Fr(~f) ]
  --[ Opened($R, nonce), ContactR($R, id_r, epk) ]->
  [ Out(deposit) ]
#endif
#ifdef FIRST_OPENER
rule Open_link:
  let deposit = <'claim', id_r, 'g' ^ ~f>
  in
  [ !User($R, id_r), In(<'link', epk, nonce>), Fr(~f) ]
  --[ Opened($R, nonce), ContactR($R, id_r, epk) ]->
  [ Out(deposit) ]
#endif

/* The sender retrieves the deposit and finalizes: the opener's identity
   becomes a contact. */
#ifdef not FIRST_OPENER & not PIN_CONFIRMED
rule Finalize:
  [ Sender($I, e, nonce, code), !User($I, id_i), In(<'claim', blind(Y, code), senc(id_r, Y ^ e)>) ]
  --[ ContactAdded($I, id_i, id_r), ContactVia($I, id_r, nonce) ]->
  [ ]
#endif
#ifdef PIN_CONFIRMED
rule Finalize:
  [ Sender($I, e, nonce, pin), !User($I, id_i), In(<'claim', id_r, fpk, proof>) ]
  --[ Eq(proof, h(<pin, id_r, fpk, nonce>)), ContactAdded($I, id_i, id_r) ]->
  [ ]
#endif
#ifdef FIRST_OPENER
rule Finalize:
  [ Sender($I, e, nonce), !User($I, id_i), In(<'claim', id_r, fpk>) ]
  --[ ContactAdded($I, id_i, id_r) ]->
  [ ]
#endif

lemma executable:
  exists-trace
  "Ex I P idi idp #s #c #a.
     Shared(I, P) @ s & Registered(P, idp) @ a & ContactAdded(I, idi, idp) @ c"

/* The sender's new contact is the person the sender meant the link for. */
// @claim: S9
#ifdef not FIRST_OPENER & not PIN_CONFIRMED
lemma contact_only_after_approval:
  "All I idi idr n #c #v.
     ContactAdded(I, idi, idr) @ c & ContactVia(I, idr, n) @ v
     ==> (Ex P #s #r. Shared(I, P) @ s & Registered(P, idr) @ r)
         | (Ex #g. GuessWon(n) @ g)"
#else
lemma contact_only_after_approval:
  "All I idi idr #c.
     ContactAdded(I, idi, idr) @ c
     ==> Ex P #s #r. Shared(I, P) @ s & Registered(P, idr) @ r"
#endif

end
