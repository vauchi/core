{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserAction",
  "description": "An action the user performed in the UI.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "TextChanged"
      ],
      "properties": {
        "TextChanged": {
          "type": "object",
          "required": [
            "component_id",
            "value"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "ItemToggled"
      ],
      "properties": {
        "ItemToggled": {
          "type": "object",
          "required": [
            "component_id",
            "item_id"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "item_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "ActionPressed"
      ],
      "properties": {
        "ActionPressed": {
          "type": "object",
          "required": [
            "action_id"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "User selected a top-level navigation target (tab bar / sidebar). `action_id` is the opaque token core minted on the corresponding `TabInfo.action_id`; the frontend forwards it verbatim and never constructs or parses it. `AppEngine::handle_action` intercepts this before per-screen dispatch and resolves it to `NavigateTo` (ADR-043 Amendment 4: forward navigation is core-resolved). Kept distinct from `ActionPressed` so global-chrome navigation and per-screen actions stay on separate dispatch lanes and cannot collide on `action_id`.",
      "type": "object",
      "required": [
        "NavigateToTab"
      ],
      "properties": {
        "NavigateToTab": {
          "type": "object",
          "required": [
            "action_id"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "The OS back gesture (Android system BACK / swipe, iOS edge-swipe, ESC). `AppEngine::handle_action` intercepts it before per-screen dispatch and owns the decision (ADR-043 Amendment 4: navigation is core-resolved; ADR-044 Amendment 2a: the frontend forwards it *unconditionally* and never gates its handler on `can_go_back`). A back step (engine-internal sub-flow or `nav_history`) pops via `navigate_back()` → `NavigateTo`; a back-stopping root has nothing to pop → `PerformNativeBack`, and the frontend performs its platform default (minimize / suspend / no-op).",
      "type": "string",
      "enum": [
        "NavigateBack"
      ]
    },
    {
      "type": "object",
      "required": [
        "FieldVisibilityChanged"
      ],
      "properties": {
        "FieldVisibilityChanged": {
          "type": "object",
          "required": [
            "field_id",
            "visible"
          ],
          "properties": {
            "field_id": {
              "type": "string"
            },
            "group_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "visible": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "VariantSelected"
      ],
      "properties": {
        "VariantSelected": {
          "type": "object",
          "properties": {
            "variant_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "SearchChanged"
      ],
      "properties": {
        "SearchChanged": {
          "type": "object",
          "required": [
            "component_id",
            "query"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "ListItemSelected"
      ],
      "properties": {
        "ListItemSelected": {
          "type": "object",
          "required": [
            "component_id",
            "item_id"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "item_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "A `vauchi://...` link was opened by the OS, share sheet, or messaging app. Core parses the URI, validates eligibility, and navigates to the appropriate screen (exchange consent, device-link join, etc.). Per ADR-021: frontends forward the raw URI and never construct navigation targets or decide which flow it belongs to.",
      "type": "object",
      "required": [
        "LinkOpened"
      ],
      "properties": {
        "LinkOpened": {
          "type": "object",
          "required": [
            "uri"
          ],
          "properties": {
            "uri": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "User invoked a per-row action (swipe, long-press, or overflow menu). `action_id` matches the id on the [`crate::ui::ListItemAction`] the engine produced for that row.",
      "type": "object",
      "required": [
        "ListItemAction"
      ],
      "properties": {
        "ListItemAction": {
          "type": "object",
          "required": [
            "action_id",
            "component_id",
            "item_id"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            },
            "component_id": {
              "type": "string"
            },
            "item_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "SettingsToggled"
      ],
      "properties": {
        "SettingsToggled": {
          "type": "object",
          "required": [
            "component_id",
            "item_id"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "item_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "The lazy list is approaching the edge of the emitted window — the renderer asks the engine to re-slice the windowed [`crate::ui::Component::List`] from `offset`. Only meaningful for windowed emissions (`total_count > 0`); the engine clamps the offset, re-slices, and answers with the usual `UpdateScreen` (`2026-06-11-contacts-list-eager-render-anr` Track B).",
      "type": "object",
      "required": [
        "ListWindowRequested"
      ],
      "properties": {
        "ListWindowRequested": {
          "type": "object",
          "required": [
            "component_id",
            "offset"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "offset": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "User pressed Undo on a toast with an undo action.",
      "type": "object",
      "required": [
        "UndoPressed"
      ],
      "properties": {
        "UndoPressed": {
          "type": "object",
          "required": [
            "action_id"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "User changed a slider value.\n\n`value_milli` is the new value scaled by 1000 (e.g., -300 for -0.3). This avoids `f32` in the action enum so `Eq` is preserved across FFI boundaries.",
      "type": "object",
      "required": [
        "SliderChanged"
      ],
      "properties": {
        "SliderChanged": {
          "type": "object",
          "required": [
            "component_id",
            "value_milli"
          ],
          "properties": {
            "component_id": {
              "type": "string"
            },
            "value_milli": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "User tapped the (i) info icon on a component. Core resolves the key to localized help content.",
      "type": "object",
      "required": [
        "InfoRequested"
      ],
      "properties": {
        "InfoRequested": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}